# Environment
# Controls debug features and scheduler behavior:
# - 'production' (default): Only saves images when errors occur, ALWAYS enables scheduler
# - 'development' or 'debug': Saves captured images to data/captures/ before AI analysis
#
# IMPORTANT: In production, scheduler is ALWAYS enabled regardless of ENABLE_SCHEDULER
NODE_ENV=production

# Scheduler Enable/Disable
# ENABLE_SCHEDULER: Control whether to use scheduler or run immediately
# - In production (NODE_ENV=production): ALWAYS ENABLED (this setting is ignored)
# - In development: Respects this setting
#
# Values: 'true', '1', 'yes' = enabled | anything else or unset = disabled
#
# Examples:
# - Production: Scheduler always enabled (runs at scheduled times, long-running)
# - Development with ENABLE_SCHEDULER=true: Scheduler enabled (same as production)
# - Development with ENABLE_SCHEDULER unset/false: Immediate mode (run once and exit)
#
# Immediate mode is useful for:
# - Local development and testing
# - Running manually with `npm start`
# - Debugging without waiting for scheduled times
ENABLE_SCHEDULER=

# CCTV Source Selection (Immediate Mode Only)
# CCTV_SOURCE: Select which CCTV source to scrape
# - 'banjarkab': Kabupaten Banjar (https://cctv.banjarkab.go.id/grid)
# - 'banjarbaru': Kota Banjarbaru (https://cctv.banjarbarukota.go.id/CCTV)
# - UNSET or EMPTY: Process BOTH sources synchronously (in sequence)
#
# NOTE: Only used when scheduler is disabled (immediate mode)
# In scheduled mode, this is ignored (both sources run at their scheduled times)
# When unset/empty in immediate mode, both sources will be processed
CCTV_SOURCE=

# Schedule Configuration (Dual-Source Mode)
# SCHEDULE_TIMES: MUST have exactly 2 comma-separated times in 24-hour format (HH:MM)
#
# Format: "time1,time2"
#   - First time (time1): Runs Banjarkab scraper
#   - Second time (time2): Runs Banjarbaru scraper
#
# Examples:
#   SCHEDULE_TIMES=05:00,15:00  → Banjarkab at 5 AM, Banjarbaru at 3 PM
#   SCHEDULE_TIMES=06:00,18:00  → Banjarkab at 6 AM, Banjarbaru at 6 PM
#
# IMPORTANT: Must have exactly 2 values (not 1, not 3)
# Invalid examples:
#   SCHEDULE_TIMES=05:00           ✗ Only 1 time (missing second source)
#   SCHEDULE_TIMES=05:00,12:00,18:00  ✗ 3 times (too many)
SCHEDULE_TIMES=05:00,15:00

# TZ: Timezone using IANA timezone identifier
# Common Indonesian timezones:
# - Asia/Makassar  → WITA (GMT+8): Makassar, Banjarmasin, Balikpapan
# - Asia/Jakarta   → WIB (GMT+7): Jakarta, Bandung, Surabaya
# - Asia/Jayapura  → WIT (GMT+9): Jayapura, Manokwari
#
# Other common timezones:
# - Asia/Singapore → SGT (GMT+8)
# - Asia/Manila    → PHT (GMT+8)
# - Asia/Bangkok   → ICT (GMT+7)
# - Asia/Tokyo     → JST (GMT+9)
# - UTC            → UTC (GMT+0)
TZ=Asia/Makassar

# Browser Configuration
# CHROMIUM_PATH: Path to browser executable (only needed if NOT using BROWSER_CHANNEL)
# - When using BROWSER_CHANNEL=chrome, leave this UNSET - Playwright auto-detects Chrome
# - For Docker: DO NOT SET THIS - Docker image has Chrome built-in
# - For local development on Linux: uncomment if needed
# CHROMIUM_PATH=/usr/bin/chromium

HEADLESS=false
BROWSER_CHANNEL=chrome

# Firefox Fallback Configuration
# ENABLE_FIREFOX_FALLBACK: Automatically retry failed HLS streams with Firefox
# - 'true' (default): When Chrome fails to load a camera's HLS stream, automatically retry with Firefox
# - 'false': Disable fallback, only use the primary browser
#
# Background: Some HLS streams work better in Firefox than Chrome. When enabled, cameras that
# show error.png in Chrome will be automatically retried with Firefox before giving up.
#
# Note: Only works when BROWSER_CHANNEL=chrome. If already using Firefox, fallback is skipped.
ENABLE_FIREFOX_FALLBACK=true

# Capture Configuration
# TARGET_COUNT: Number of cameras to capture (will navigate through pagination if needed)
# Format: "count" or "count1,count2"
#
# Single value: Same count for both sources
#   TARGET_COUNT=3  → Capture 3 cameras from each source
#
# Two values: Separate counts for each source
#   TARGET_COUNT=5,3  → Banjarkab: 5 cameras, Banjarbaru: 3 cameras
#
# Examples:
#   TARGET_COUNT=3     → Both sources capture 3 cameras
#   TARGET_COUNT=5,10  → Banjarkab: 5, Banjarbaru: 10
#   TARGET_COUNT=10,5  → Banjarkab: 10, Banjarbaru: 5
TARGET_COUNT=3

# BANJARBARU_FILTER: Filter Banjarbaru cameras by keyword (case-insensitive)
# Only cameras with titles matching this keyword will be captured
# Leave empty or unset to capture all cameras (respecting TARGET_COUNT)
#
# Examples:
#   BANJARBARU_FILTER=cempaka     → Only cameras with "cempaka" in the title
#   BANJARBARU_FILTER=jembatan    → Only cameras with "jembatan" in the title
#   BANJARBARU_FILTER=            → No filter (capture all, default)
#
# Use case: If you only want to monitor specific camera locations in Banjarbaru
# Note: This only affects Banjarbaru source, Banjarkab captures all cameras
BANJARBARU_FILTER=

OUTPUT_DIR=data/snapshots
MAX_RETRIES=2

# Timeouts (in milliseconds)
PAGE_LOAD_TIMEOUT=90000
SELECTOR_TIMEOUT=30000
VIDEO_INIT_WAIT=5000
VIDEO_READY_TIMEOUT=5000
CAPTURE_TIMEOUT=20000

# Logging
ERROR_LOG_FILE=capture_errors.log

# Google GenAI Configuration
GOOGLE_GENAI_API_KEY=your_google_genai_api_key_here
GOOGLE_GENAI_MODEL=models/gemini-flash-latest

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_channel_or_chat_id

# TELEGRAM_BATCH_SIZE: Maximum images per media group when sending to Telegram
# - Default: 5 (recommended for reliability)
# - Telegram API max: 10
# - Lower values (e.g., 5) reduce timeout risk but send more batches
# - Higher values (e.g., 10) send fewer batches but may timeout on slow networks
# - Set to 0 to disable batching (send all images in one group)
#
# NOTE: If you increase TARGET_COUNT above 10, batching will automatically split
# images into multiple media groups. Each batch sends separately with a 1-second
# delay between batches to avoid rate limiting.
#
# Examples:
# - 10 images with BATCH_SIZE=5  → sends 2 batches of 5 images each
# - 10 images with BATCH_SIZE=10 → sends 1 batch of 10 images
# - 15 images with BATCH_SIZE=5  → sends 3 batches (5+5+5)
# - 15 images with BATCH_SIZE=10 → sends 2 batches (10+5)
TELEGRAM_BATCH_SIZE=5
